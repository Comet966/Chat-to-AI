# ==============================================================================
# 本地开发测试环境变量示例 (Local Development & Testing Environment Variables)
# ==============================================================================
# 开发模式默认使用 docs/todo.md 中的本地回环测试配置，无须复制本文件。
# 需要覆盖默认值时，复制本文件为 .env.local 并修改；不要提交真实密钥。
#
# 设为 0 可关闭开发默认供应商；打包版始终不加载开发预设。
# DESKTOP_ENABLE_LOCAL_PROVIDER_PRESET=0

# 本地 OpenAI-compatible 网关的可选覆盖项（未设置时使用注释中的默认值）：
# LOCAL_OPENAI_BASE_URL=http://127.0.0.1:8317/v1
# LOCAL_OPENAI_API_KEY=1145141919810
# LOCAL_OPENAI_MODEL_ID=gpt-4o
# LOCAL_OPENAI_MAX_OUTPUT_TOKENS=2048

# 若回环网关没有 gpt-4o，可在供应商设置页点“Load Models”后选择实际模型。

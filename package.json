{
  "name": "chat-to-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck:core": "pnpm --filter chat-contracts --filter chat-core run typecheck",
    "lint:boundaries": "node scripts/lint-boundaries.mjs",
    "test:core": "vitest run tests/contracts tests/core",
    "build:core": "pnpm --filter chat-contracts --filter chat-core run build",
    "test:transport": "vitest run tests/adapters tests/transport",
    "build:desktop": "pnpm --filter chat-desktop run build",
    "build:debug-ui": "pnpm --filter chat-debug-renderer run build",
    "cli:test": "pnpm --filter chat-test-cli run start",
    "typecheck:test-cli": "pnpm --filter chat-test-cli run typecheck",
    "test:test-cli": "vitest run tests/cli",
    "build:test-cli": "pnpm --filter chat-model-adapters --filter chat-test-cli run build",
    "typecheck:conversation-tree": "pnpm --filter chat-conversation-tree run typecheck",
    "test:conversation-tree": "vitest run tests/conversation-tree",
    "build:conversation-tree": "pnpm --filter chat-conversation-tree run build",
    "typecheck:conversation-runtime": "pnpm --filter chat-conversation-runtime run typecheck",
    "test:conversation-runtime": "vitest run tests/conversation-runtime tests/cli",
    "build:conversation-runtime": "pnpm --filter chat-conversation-runtime run build",
    "cli:session": "pnpm --filter chat-test-cli run start -- --interactive",
    "typecheck": "pnpm -r run typecheck",
    "test": "vitest run",
    "build": "pnpm -r run build"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "22.13.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.3.4",
    "jsdom": "26.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "typescript": "5.8.2",
    "vite": "6.2.1",
    "vitest": "3.0.8"
  }
}

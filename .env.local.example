# ==============================================================================
# 本地开发测试环境变量示例 (Local Development & Testing Environment Variables)
# ==============================================================================
# 使用方式：复制本文件为 .env.local 并填入本地配置，严禁提交真实密钥到版本库。
#
# 1. 显式开启本地开发 Provider 预设功能
DESKTOP_ENABLE_LOCAL_PROVIDER_PRESET=1

# 启动 Electron 后会自动使用下面的本地供应商配置；也可以在设置页手动载入预设。

# 2. 本地代理 Anthropic 测试服务地址 (通常指向本地反向代理或网关)
LOCAL_ANTHROPIC_BASE_URL=http://127.0.0.1:8317
LOCAL_ANTHROPIC_CATALOG_URL=http://127.0.0.1:8317/v1
LOCAL_ANTHROPIC_MODEL_ID=claude-3-5-sonnet-20241022
LOCAL_ANTHROPIC_MAX_OUTPUT_TOKENS=2048
LOCAL_ANTHROPIC_VERSION=2023-06-01

# 3. 本地测试 API 密钥 (仅保存在本地 .env.local 中，不上传)
LOCAL_ANTHROPIC_API_KEY=
